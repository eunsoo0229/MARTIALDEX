# Copy this file to .env and fill in your own key. .env is gitignored and is
# only ever read by the Electron main process (electron/main.cjs) — it is
# never bundled into the renderer/frontend code.
#
# Get a free API key at https://aistudio.google.com/apikey (Google AI Studio
# free tier, no billing required).
GEMINI_API_KEY=

# Optional: override which Gemini model is used. Defaults to a free-tier
# eligible Flash model if unset.
GEMINI_MODEL=gemini-3.6-flash

# Real external web search for AI Curriculum's External Research stage
# (aiCurriculum/techniqueResearch.ts) — used BEFORE Gemini's own Google
# Search grounding tool, which is billing-gated on the free tier (see that
# file's doc comments). Get a free API key at https://tavily.com (1,000
# searches/month free, no credit card required as of this writing). Leave
# empty to skip straight to the existing grounded/knowledge-fallback path.
TAVILY_API_KEY=

# 21단계 — Supabase Auth + database. Unlike GEMINI_API_KEY above, these ARE
# read by Vite and bundled into the renderer (see src/lib/supabase/client.ts)
# — that is intentional and safe: the "publishable"/anon key is designed to
# be public, security comes from Row Level Security in the database, not
# from hiding this key. Get these from your Supabase project's
# Settings → API page. NEVER put a service_role key in this file or anywhere
# in this project — it bypasses Row Level Security entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 32단계 — TossPayments V2 실 연동(테스트 모드만). VITE_TOSS_CLIENT_KEY는
# Toss의 "클라이언트 키"(test_ck_... 형태)로, Stripe의 publishable key처럼
# 공개되어도 안전하도록 설계된 값이라 렌더러에 그대로 번들되어도 문제 없다.
# 비워두면(기본값) 앱은 기존 TestPaymentProvider/PaymentModal 흐름을 그대로
# 사용한다 — 이 값이 실제로 채워졌을 때만 결제 버튼이 Toss 결제창을 연다.
# https://developers.tosspayments.com/my/api-keys 에서 발급받은 "테스트"
# 클라이언트 키만 넣을 것 — 절대 라이브(실 결제) 키를 넣지 않는다.
VITE_TOSS_CLIENT_KEY=

# 절대 이 파일이나 VITE_ 접두사가 붙은 어떤 변수로도 넣지 말 것: Toss의
# "시크릿 키"(test_sk_.../live_sk_...)는 결제 서버 승인(POST
# /v1/payments/confirm)에 쓰이는 비밀값으로, Supabase Edge Function 시크릿
# 으로만 존재해야 한다(렌더러/APK에 들어가면 누구나 결제를 위조 승인할 수
# 있게 됨 — scripts/check-apk-no-payment-secrets.mjs가 빌드 결과물에서 이
# 이름이 발견되면 빌드를 실패시킨다):
#   supabase secrets set PAYMENT_SECRET_KEY=<발급받은 테스트 시크릿 키>
#   supabase functions deploy payment-verify
