{
  "name": "martialdex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Martial Arts Encyclopedia - desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "parse": "node scripts/parse-techniques.mjs",
    "dev:vite": "vite",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:mac": "npm run build && electron-builder --mac --x64 --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.config.cjs",
    "prebuild:android": "node scripts/validate-android-config.mjs",
    "check:apk-secrets": "node scripts/check-apk-no-payment-secrets.mjs",
    "audit:technique-relations": "node scripts/consolidate-technique-art-decisions.mjs && node scripts/build-technique-canonical.mjs && node scripts/report-technique-relations.mjs && node scripts/audit-technique-art-matrix.mjs && node scripts/report-technique-art-matrix.mjs",
    "dist:android": "npm run prebuild:android && npm run build && npm run check:apk-secrets && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tosspayments/tosspayments-sdk": "^2.8.0",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "supabase": "^2.114.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
